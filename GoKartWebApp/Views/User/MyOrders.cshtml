@model IEnumerable<GoKartWebApp.Models.Order>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Orders";
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark"><i class="fa-solid fa-box text-primary me-2"></i>My Orders</h4>
        <input type="text" class="form-control w-25" placeholder="Search orders..." />
    </div>

    <div class="table-responsive">
        <table class="table align-middle table-hover">
            <thead class="table-light">
                <tr>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@item.OrderNumber</td>
                        <td>@item.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.Status == "Delivered")
                            {<span class="status-badge status-delivered">Delivered</span> }
                            else if (item.Status == "Shipped")
                            { <span class="status-badge status-shipped">Shipped</span> }
                            else
                            { <span class="status-badge status-pending">Pending</span>}
                        </td>
                        <td class="fw-bold">₹ @item.TotalAmount.ToString("N0")</td>
                        <td>
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3">Track Order</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>