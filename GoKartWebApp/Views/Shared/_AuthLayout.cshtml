<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GoKart Shopping</title>

    <!-- Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f1f3f6;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            min-height: 100vh;
        }

        .auth-header {
            background: #ffffff;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        }

        .auth-brand {
            font-weight: 800;
            font-size: 1.6rem;
            color: #2874f0;
            text-decoration: none;
            font-style: italic;
        }

            .auth-brand span {
                color: #f59e0b;
                font-size: 0.75rem;
                font-style: normal;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Header -->
    <header class="auth-header py-3">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="@Url.Action("Index", "Home")" class="auth-brand">
                GoKart <span>Plus Explore <i class="fa-solid fa-plus text-warning"></i></span>
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Shopping
            </a>
        </div>
    </header>

    <!-- Main Section -->
    <main class="flex-grow-1 d-flex align-items-center py-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="text-center py-3 text-muted bg-white border-top">
        <small>&copy; @DateTime.Now.Year GoKart Online Shopping. All Rights Reserved.</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>