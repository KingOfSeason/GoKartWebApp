@model IEnumerable<GoKartWebApp.Models.Coupon>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Manage Coupons";
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold"><i class="fa-solid fa-ticket text-primary me-2"></i>Coupons & Discounts</h4>
        <button class="btn btn-primary rounded-3"><i class="fa-solid fa-plus me-2"></i>Create Coupon</button>
    </div>

    <table class="table align-middle">
        <thead class="table-light">
            <tr>
                <th>Coupon Code</th>
                <th>Discount</th>
                <th>Expiry Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-bold text-primary">@c.CouponCode</td>
                    <td><span class="badge bg-success">@c.DiscountPercent% OFF</span></td>
                    <td>@c.ExpiryDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (c.IsActive)
                        {<span class="badge bg-primary">Active</span> }
                        else
                        { <span class="badge bg-secondary">Expired</span>}
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>