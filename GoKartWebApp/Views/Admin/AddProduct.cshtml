@model GoKartWebApp.Models.Product
@{
    ViewBag.Title = "Add Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-plus-circle text-primary me-2"></i>Add New Product</h4>

    @using (Html.BeginForm("AddProduct", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Product Name</label>
                @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", placeholder = "e.g. Samsung Galaxy S23", required = "required" })
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Category</label>
                @Html.TextBoxFor(m => m.Category, new { @class = "form-control", placeholder = "e.g. Electronics, Clothing", required = "required" })
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Selling Price (₹)</label>
                @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Original Price (₹)</label>
                @Html.TextBoxFor(m => m.OriginalPrice, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Discount (%)</label>
                @Html.TextBoxFor(m => m.DiscountPercent, new { @class = "form-control", type = "number", required = "required" })
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Stock Quantity</label>
                @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control", type = "number", required = "required" })
            </div>

            <!-- IMAGE UPLOAD FIELD -->
            <div class="col-md-12">
                <label class="form-label fw-semibold">Upload Product Image</label>
                <input type="file" name="ImageFile" class="form-control" accept="image/*" required />
            </div>

            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold">
                    <i class="fa-solid fa-upload me-2"></i> Save & Upload Product
                </button>
            </div>
        </div>
    }
</div>