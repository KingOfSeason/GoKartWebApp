@model IEnumerable<GoKartWebApp.Models.Product>
@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h3 class="fw-bold">Admin Dashboard</h3>
<p class="text-muted">Welcome back, Admin! Here's what's happening with your store today.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 my-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-primary text-white rounded-4">
            <span>Total Orders</span>
            <h2 class="fw-bold mt-2">@ViewBag.TotalOrders</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-success text-white rounded-4">
            <span>Total Sales</span>
            <h2 class="fw-bold mt-2">₹ @ViewBag.TotalSales</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-info text-white rounded-4">
            <span>Total Customers</span>
            <h2 class="fw-bold mt-2">@ViewBag.TotalCustomers</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-warning text-dark rounded-4">
            <span>Total Products</span>
            <h2 class="fw-bold mt-2">@ViewBag.TotalProducts</h2>
        </div>
    </div>
</div>

<!-- Products Table with Edit/Delete Actions -->
<div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold">Product Catalog</h5>
        <a href="@Url.Action("AddProduct", "Admin")" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-plus"></i> Add New Product
        </a>
    </div>

    <table class="table align-middle">
        <thead>
            <tr class="text-muted">
                <th>Image</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@Url.Content(item.ImageUrl ?? "~/Images/Products/default.jpg")" style="width: 50px; height: 50px; object-fit: cover;" class="rounded-3 shadow-sm" />
                        </td>
                        <td class="fw-bold">@item.ProductName</td>
                        <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                        <td class="text-success fw-bold">₹ @item.Price</td>
                        <td>@item.StockQuantity</td>
                        <td>
                            <a href="@Url.Action("EditProduct", "Admin", new { id = item.ProductID })" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">
                                <i class="fa-solid fa-pen"></i> Edit
                            </a>
                            <a href="@Url.Action("DeleteProduct", "Admin", new { id = item.ProductID })" onclick="return confirm('Are you sure you want to delete this product?');" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                <i class="fa-solid fa-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No products found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>