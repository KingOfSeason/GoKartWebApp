@model GoKartWebApp.Models.Product
@{
    ViewBag.Title = "Edit Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-pen text-primary me-2"></i>Edit Product</h4>

    @using (Html.BeginForm("EditProduct", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ProductID)

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Product Name</label>
                @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", required = "required" })
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Category</label>
                @Html.TextBoxFor(m => m.Category, new { @class = "form-control", required = "required" })
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Selling Price (₹)</label>
                @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Original Price (₹)</label>
                @Html.TextBoxFor(m => m.OriginalPrice, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Discount (%)</label>
                @Html.TextBoxFor(m => m.DiscountPercent, new { @class = "form-control", type = "number", required = "required" })
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Stock Quantity</label>
                @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control", type = "number", required = "required" })
            </div>

            <!-- Current Image Preview -->
            <div class="col-md-12 my-2">
                <label class="form-label fw-semibold d-block">Current Image</label>
                <img src="@Url.Content(Model.ImageUrl ?? "~/Images/Products/default.jpg")" style="width: 100px; height: 100px; object-fit: cover;" class="rounded-3 border" />
            </div>

            <div class="col-md-12">
                <label class="form-label fw-semibold">Upload New Image (Optional)</label>
                <input type="file" name="ImageFile" class="form-control" accept="image/*" />
            </div>

            <div class="col-md-12">
                <div class="form-check form-switch">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "isActiveSwitch" })
                    <label class="form-check-label fw-semibold" for="isActiveSwitch">Is Product Active</label>
                </div>
            </div>

            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold">Update Product</button>
                <a href="@Url.Action("Index", "Admin")" class="btn btn-light px-4 rounded-pill">Cancel</a>
            </div>
        </div>
    }
</div>