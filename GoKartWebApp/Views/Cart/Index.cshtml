@model IEnumerable<GoKartWebApp.Models.CartItem>
@{
    ViewBag.Title = "Shopping Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal grandTotal = ViewBag.GrandTotal ?? 0;
}

<div class="container py-4">
    <h3 class="fw-bold mb-4"><i class="fa-solid fa-cart-shopping me-2 text-primary"></i>My Shopping Cart</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <!-- Left Side: Product List -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="bg-light">
                                    <tr class="text-muted text-uppercase small">
                                        <th class="ps-4">Product</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                        <th class="text-end pe-4">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="@Url.Content(string.IsNullOrEmpty(item.ImageUrl) ? "~/Images/Products/default.jpg" : item.ImageUrl)"
                                                         alt="@item.ProductName"
                                                         class="rounded-3"
                                                         style="width: 60px; height: 60px; object-fit: contain; background: #f8f9fa;"
                                                         onerror="this.onerror=null; this.src='https://via.placeholder.com/60';" />
                                                    <div>
                                                        <h6 class="fw-bold mb-0 text-dark">@item.ProductName</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="fw-semibold">₹@item.Price</td>
                                            <td>
                                                @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-flex align-items-center gap-1" }))
                                                {
                                                    <input type="hidden" name="productId" value="@item.ProductID" />
                                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="10"
                                                           class="form-control form-control-sm rounded-pill text-center"
                                                           style="width: 65px;" onchange="this.form.submit()" />
                                                }
                                            </td>
                                            <td class="fw-bold text-success">₹@item.Total</td>
                                            <td class="text-end pe-4">
                                                <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })"
                                                   class="btn btn-sm btn-outline-danger rounded-circle"
                                                   title="Remove Item">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fa-solid fa-arrow-left me-2"></i>Continue Shopping
                    </a>
                    <a href="@Url.Action("ClearCart", "Cart")" class="btn btn-link text-danger text-decoration-none small">
                        Clear Cart
                    </a>
                </div>
            </div>

            <!-- Right Side: Price Details Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold border-bottom pb-3 mb-3">Price Details</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Price (@Model.Sum(x => x.Quantity) items)</span>
                        <span class="fw-semibold">₹@grandTotal</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Delivery Charges</span>
                        <span class="text-success fw-semibold">FREE</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fs-5 fw-bold mb-4">
                        <span>Total Amount</span>
                        <span class="text-primary">₹@grandTotal</span>
                    </div>

                    <a href="@Url.Action("Index", "Orders")" class="btn btn-warning py-3 fw-bold w-100 rounded-3 shadow-sm text-dark">
                        PLACE ORDER
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="fa-solid fa-cart-flatbed display-1 text-muted mb-3"></i>
            <h4 class="fw-bold text-secondary">Your Cart is Empty!</h4>
            <p class="text-muted">Explore our catalog and add items to your cart.</p>
            <div class="mt-3">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                    Shop Now
                </a>
            </div>
        </div>
    }
</div>