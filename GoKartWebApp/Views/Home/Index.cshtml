@model IEnumerable<GoKartWebApp.Models.Product>
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- BANNER SECTION -->
<div class="card border-0 rounded-4 text-white p-4 p-md-5 mb-4 shadow-sm" style="background: linear-gradient(135deg, #2874f0, #0052cc);">
    <div class="row align-items-center">
        <div class="col-md-8">
            @if (ViewBag.SelectedCategory != null)
            {
                <h1 class="fw-bold display-5">@ViewBag.SelectedCategory Store</h1>
                <p class="lead mb-0">Explore the best deals in @ViewBag.SelectedCategory.</p>
            }
            else if (ViewBag.SearchKeyword != null)
            {
                <h1 class="fw-bold display-5">Search Results for "@ViewBag.SearchKeyword"</h1>
                <p class="lead mb-0">Showing matching products from our catalog.</p>
            }
            else
            {
                <h1 class="fw-bold display-5">Welcome to GoKart!</h1>
                <p class="lead mb-0">Shop the best products with exclusive discounts and fast delivery.</p>
            }
        </div>
        <div class="col-md-4 text-end d-none d-md-block">
            <i class="fa-solid fa-bag-shopping display-1 opacity-25"></i>
        </div>
    </div>
</div>

<!-- PRODUCTS SECTION -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">
        @(ViewBag.SelectedCategory ?? ViewBag.SearchKeyword ?? "Featured Products")
    </h4>
    @if (ViewBag.SelectedCategory != null || ViewBag.SearchKeyword != null)
    {
        <a href="@Url.Action("Index", "Home")" class="btn btn-sm btn-outline-secondary rounded-pill">
            <i class="fa-solid fa-xmark me-1"></i> Clear Filter
        </a>
    }
</div>

<div class="row g-3">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                    <div class="position-relative text-center p-3 bg-light">
                        @if (item.DiscountPercent > 0)
                        {
                            <span class="badge bg-danger position-absolute top-0 start-0 m-2 rounded-pill px-2 py-1 fs-7">
                                @item.DiscountPercent% OFF
                            </span>
                        }
                        
                        <!-- Fixed Image Path Handling -->
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/Images/Products/default.jpg") : Url.Content(item.ImageUrl))" 
                             alt="@item.ProductName" 
                             class="img-fluid rounded-3" 
                             style="height: 180px; object-fit: contain;"
                             onerror="this.onerror=null;this.src='https://via.placeholder.com/200x200?text=Product+Image';" />
                    </div>

                    <div class="card-body d-flex flex-column p-3">
                        <span class="badge bg-light text-secondary border w-auto align-self-start mb-2">@item.Category</span>
                        <h6 class="fw-bold text-dark text-truncate mb-1" title="@item.ProductName">@item.ProductName</h6>

                        <div class="mt-auto pt-2">
                            <div class="d-flex align-items-baseline gap-2 mb-2">
                                <span class="fw-bold fs-5 text-dark">₹@item.Price</span>
                                @if (item.OriginalPrice > item.Price)
                                {
                                    <span class="text-muted text-decoration-line-through small">₹@item.OriginalPrice</span>
                                }
                            </div>

                            <div class="d-grid gap-2">
                                <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="fa-solid fa-box-open display-1 text-muted mb-3"></i>
            <h5 class="fw-bold text-secondary">No products found</h5>
            <p class="text-muted">Try selecting a different category or clear filters.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary rounded-pill px-4">Show All Products</a>
        </div>
    }
</div>

<style>
    .product-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.12) !important;
    }
</style>