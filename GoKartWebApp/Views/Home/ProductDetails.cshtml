@model GoKartWebApp.Models.Product
@{
    ViewBag.Title = Model.ProductName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var relatedProducts = ViewBag.RelatedProducts as List<GoKartWebApp.Models.Product>;
}

<div class="container py-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home", new { category = Model.Category })" class="text-decoration-none">@Model.Category</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>

    <!-- MAIN PRODUCT DETAILS SECTION -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4 align-items-center">
                <!-- Left: Product Image -->
                <div class="col-md-5 text-center position-relative">
                    <div class="bg-light rounded-4 p-4 d-flex align-items-center justify-content-center" style="min-height: 380px;">
                        @if (Model.DiscountPercent > 0)
                        {
                            <span class="badge bg-danger position-absolute top-0 start-0 m-3 rounded-pill px-3 py-2 fs-6">
                                @Model.DiscountPercent% OFF
                            </span>
                        }
                        <img src="@Url.Content(string.IsNullOrEmpty(Model.ImageUrl) ? "~/Images/Products/default.jpg" : Model.ImageUrl)"
                             alt="@Model.ProductName"
                             class="img-fluid rounded-3"
                             style="max-height: 320px; object-fit: contain;"
                             onerror="this.src='https://via.placeholder.com/350?text=No+Image';" />
                    </div>
                </div>

                <!-- Right: Product Info & Buy Options -->
                <div class="col-md-7">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-semibold mb-2">
                        @Model.Category
                    </span>
                    <h2 class="fw-bold text-dark mb-2">@Model.ProductName</h2>

                    <!-- Rating Mockup -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-success px-2 py-1 fs-7">
                            4.3 <i class="fa-solid fa-star small"></i>
                        </span>
                        <span class="text-muted small">(1,248 Ratings & 180 Reviews)</span>
                    </div>

                    <hr />

                    <!-- Price Section -->
                    <div class="d-flex align-items-baseline gap-3 mb-3">
                        <span class="display-6 fw-bold text-dark">₹@Model.Price</span>
                        @if (Model.OriginalPrice > Model.Price)
                        {
                            <span class="fs-5 text-muted text-decoration-line-through">₹@Model.OriginalPrice</span>
                            <span class="text-success fw-bold">Save ₹@(Model.OriginalPrice - Model.Price)</span>
                        }
                    </div>

                    <!-- Stock Status -->
                    <div class="mb-4">
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                <i class="fa-solid fa-circle-check me-1"></i> In Stock (@Model.StockQuantity available)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                                <i class="fa-solid fa-circle-xmark me-1"></i> Out of Stock
                            </span>
                        }
                    </div>

                    <!-- Highlights / Description -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-secondary">Product Overview</h6>
                        <ul class="text-muted small ps-3 mb-0">
                            <li>100% Genuine and Original Quality Product.</li>
                            <li>7 Days Replacement Guarantee available.</li>
                            <li>Free Express Delivery on orders above ₹499.</li>
                            <li>Cash on Delivery (COD) supported.</li>
                        </ul>
                    </div>

                    <!-- Quantity & Action Buttons -->
                    @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Get, new { @class = "d-flex flex-wrap align-items-center gap-3" }))
                    {
                        <input type="hidden" name="id" value="@Model.ProductID" />

                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-muted small">Qty:</label>
                            <select name="quantity" class="form-select form-select-sm rounded-pill px-3" style="width: 80px;">
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-warning py-3 px-4 fw-bold text-dark rounded-3 shadow-sm flex-grow-1 flex-md-grow-0">
                            <i class="fa-solid fa-cart-plus me-2"></i>ADD TO CART
                        </button>

                        <button type="submit" class="btn btn-primary py-3 px-4 fw-bold text-white rounded-3 shadow-sm flex-grow-1 flex-md-grow-0" style="background-color: #2874f0;">
                            <i class="fa-solid fa-bolt me-2"></i>BUY NOW
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- RELATED PRODUCTS SECTION -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <div class="mt-5">
            <h4 class="fw-bold mb-3">Similar Products</h4>
            <div class="row g-3">
                @foreach (var item in relatedProducts)
                {
                    <div class="col-6 col-md-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                            <div class="p-3 bg-light text-center">
                                <img src="@Url.Content(string.IsNullOrEmpty(item.ImageUrl) ? "~/Images/Products/default.jpg" : item.ImageUrl)"
                                     alt="@item.ProductName"
                                     class="img-fluid rounded-3"
                                     style="height: 140px; object-fit: contain;"
                                     onerror="this.src='https://via.placeholder.com/150';" />
                            </div>
                            <div class="card-body p-3 d-flex flex-column">
                                <h6 class="fw-bold text-dark text-truncate mb-1">@item.ProductName</h6>
                                <span class="fw-bold text-dark mb-2">₹@item.Price</span>
                                <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })" class="btn btn-outline-primary btn-sm rounded-pill mt-auto fw-semibold">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .product-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12) !important;
        }
</style>